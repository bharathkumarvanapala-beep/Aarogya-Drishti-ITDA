# Application Environment
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Database Connection
DATABASE_URL=postgresql://aarogya:aarogya_secret@localhost:5432/aarogya_drishti_db?schema=public

# Security & JWT Tokens
JWT_SECRET=replace-with-a-unique-random-jwt_secret
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=replace-with-a-unique-random-jwt_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# Redis / BullMQ Job Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Private S3-Compatible Object Storage (MinIO / AWS S3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=aarogya-clinical-images
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Python OpenCV Quality Micro-Service
OPENCV_SERVICE_URL=http://localhost:8001

# Python AI Research Demonstration Micro-Service
AI_RESEARCH_SERVICE_URL=http://localhost:8002

# API Rate Limiting (Requests per minute)
THROTTLE_TTL=60
THROTTLE_LIMIT=120
